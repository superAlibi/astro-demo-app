	"name": "astro-demo-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars":{
		// "HOSTNAME": "localhost:4322"
	}
}